{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline v0.2",
  "type": "object",
  "required": [
    "pipeline"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "pipeline": {
      "type": "object",
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "foreach": {
          "type": "string",
          "pattern": "^(input|steps)\\."
        },
        "foreach_item": {
          "type": "string"
        },
        "item_type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "item_format": {
          "type": "string",
          "enum": [
            "text",
            "email",
            "url",
            "ip",
            "file_ref"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "plugin"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "stop",
                  "skip",
                  "retry"
                ]
              },
              "on_reject": {
                "type": "string",
                "enum": [
                  "stop",
                  "continue"
                ]
              },
              "timeout": {
                "type": "string"
              },
              "bind": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "form": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string"
                    },
                    "format": {
                      "type": "string"
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "retry": {
                "type": "object",
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "delay": {
                    "type": "string"
                  },
                  "backoff": {
                    "type": "string",
                    "enum": [
                      "fixed",
                      "exponential"
                    ]
                  }
                }
              },
              "after_foreach": {
                "type": "boolean",
                "description": "шаг выполняется один раз после foreach-цикла"
              },
              "when": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(input|steps)\\.",
                    "description": "путь: шаг выполняется, если значение истинно"
                  },
                  {
                    "type": "object",
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(input|steps)\\."
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "truthy",
                          "exists",
                          "missing",
                          "eq",
                          "neq",
                          "gt",
                          "gte",
                          "lt",
                          "lte",
                          "contains"
                        ]
                      },
                      "value": {}
                    },
                    "description": "path + оператор + значение (op по умолчанию eq)"
                  }
                ]
              },
              "foreach": {
                "type": "string",
                "pattern": "^(input|steps)\\.",
                "description": "шаг выполняется по каждому элементу массива; результаты — steps.<id>_all"
              },
              "foreach_item": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "description": "имя переменной элемента в input.* (по умолчанию item)"
              },
              "parallel_group": {
                "type": "string",
                "description": "шаги с одинаковым именем группы выполняются параллельно, барьер — до следующего шага"
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "v0.16: имена env-переменных, обязанных быть заданы (значения в YAML не живут)"
        },
        "network": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "description": "v0.17: declare-now — deny запрещает шаги, чей плагин заявил permissions.network"
        }
      }
    }
  }
}